MYSQL_DATABASE=companion
MYSQL_USER=companion
MYSQL_PASSWORD=configure_a_senha
JWT_SECRET=configure_um_segredo_aleatorio_com_pelo_menos_32_caracteres
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Deixe vazio, ou use "seed" para carregar os dados de exemplo.
SPRING_PROFILES_ACTIVE=

# Firebase Authentication (veja a seção "Configurar o Firebase" do README).
# SECRETA: JSON da conta de serviço em Base64, numa linha só. Só o backend usa.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Configuração do app web (pública, vai para o navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Só no perfil "seed": senha das contas de exemplo criadas no Firebase (6+ caracteres,
# seguindo a política de senha do projeto). Use apenas em um projeto de desenvolvimento.
SEED_USER_PASSWORD=
